const PASSWORD = "1708"; // CAMBIA QUI IL CODICE

let entered = "";

function show(id) {
  document.querySelectorAll(".screen").forEach(screen => {
    screen.classList.remove("active");
  });

  document.getElementById(id).classList.add("active");

  burst(id === "gifts" ? "🎁" : "♥");

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });
}

function key(number) {
  if (entered.length >= 4) return;

  entered += number;
  updateDisplay();

  if (entered.length === 4) {
    setTimeout(checkCode, 180);
  }
}

function clearCode() {
  entered = "";
  updateDisplay();

  document.getElementById("wrong").textContent = "";
}

function updateDisplay() {
  document.getElementById("display").textContent =
    entered.padEnd(4, "_").split("").join(" ");
}

function checkCode() {
  if (entered === PASSWORD) {

    burst("♥");

    setTimeout(() => {
      show("gifts");
    }, 300);

  } else {

    document.getElementById("wrong").textContent =
      "Codice sbagliato... riprova ♡";

    entered = "";

    updateDisplay();

    burst("✦");
  }
}

function openGift(id) {

  if (id === "letter") {
    burst("💌");
  }

  else if (id === "memory") {
    burst("📸");
  }

  else {
    burst("♫");
  }

  setTimeout(() => {
    show(id);
  }, 180);
}

function burst(symbol) {

  const container = document.getElementById("particles");

  for (let i = 0; i < 10; i++) {

    const particle = document.createElement("span");

    particle.className = "p";
    particle.textContent = symbol;

    particle.style.left =
      (30 + Math.random() * 40) + "vw";

    particle.style.top =
      (45 + Math.random() * 20) + "vh";

    particle.style.animationDelay =
      (Math.random() * 0.25) + "s";

    container.appendChild(particle);

    setTimeout(() => {
      particle.remove();
    }, 1800);
  }
}

document.addEventListener("DOMContentLoaded", () => {

  updateDisplay();

  setTimeout(() => {
    burst("♥");
  }, 500);

});